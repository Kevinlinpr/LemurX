assert(is_android)

# Browser-process pieces of lemurx.net.* that must not depend on the UI layer:
# request rules + URLLoaderThrottle, cookie access, match patterns.
source_set("lemurx") {
  sources = [
    "lemurx_cookies.cc",
    "lemurx_cookies.h",
    "lemurx_net_rules.cc",
    "lemurx_net_rules.h",
    "lemurx_sync_call.cc",
    "lemurx_sync_call.h",
    "lemurx_url_loader_throttle.cc",
    "lemurx_url_loader_throttle.h",
    "lemurx_url_pattern.cc",
    "lemurx_url_pattern.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}
