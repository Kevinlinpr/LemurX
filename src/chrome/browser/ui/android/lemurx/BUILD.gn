assert(is_android)

# The only native piece of the LemurX agent: a one-shot accessibility-tree
# snapshot and a compositor copy-output screenshot for the Java device bridge
# (LemurXAx.java / LemurXDeviceBridge.java). No DevTools, no script injection;
# everything else LemurX adds lives in Java on top of stock Chromium.
source_set("lemurx") {
  sources = [
    "lemurx_ax.cc",
    "lemurx_extensions.cc",
  ]

  deps = [
    "//base",
    "//chrome/android:chrome_jni_headers",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/toolbar:impl",
    "//chrome/common",
    "//components/prefs",
    "//components/viz/common",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//skia",
    "//ui/accessibility",
    "//ui/android",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
  ]
}
