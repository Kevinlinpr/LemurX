assert(is_android)

# The privileged Lua runtime living in the browser process: the lemurx.* API,
# the luakit-compatible natives (widgets, webview, scheme handlers, sqlite,
# regex, ...), CDP bridge and the Mojo host for renderer-side Lua.
source_set("lemurx") {
  sources = [
    "lemurx_api.cc",
    "lemurx_api.h",
    "lemurx_cdp.cc",
    "lemurx_cdp.h",
    "lemurx_engine.cc",
    "lemurx_engine.h",
    "lemurx_luakit_native.cc",
    "lemurx_luakit_native.h",
    "lemurx_luakit_scheme.cc",
    "lemurx_luakit_scheme.h",
    "lemurx_luakit_web_host.cc",
    "lemurx_luakit_web_host.h",
    "lemurx_luakit_webview.cc",
    "lemurx_luakit_webview.h",
  ]

  deps = [
    "//base",
    "//chrome/android:chrome_jni_headers",
    "//chrome/browser/lemurx",
    "//chrome/common:mojo_bindings",
    "//content/public/browser",
    "//content/public/common",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/mojom:mojom_platform",
    "//third_party/lua",
    "//third_party/re2",
    "//third_party/sqlite",
    "//ui/base",
    "//url",
  ]
}
