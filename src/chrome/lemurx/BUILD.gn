import("//build/config/android/rules.gni")

assert(is_android)

# Deployment-time configuration shipped inside the apk under assets/lemurx/.
#
# device.json is read by LemurXDeviceConfig (lemurx/agent): the OpenMuse
# server the agent device bridge should poll and the device token that
# authenticates this install. The copy in git has an empty token; a release
# pipeline injects the real one into the apk (never into the source tree).
android_assets("lemurx_assets") {
  renaming_sources = [ "//chrome/lemurx/agent/device.json" ]
  renaming_destinations = [ "lemurx/device.json" ]
}
