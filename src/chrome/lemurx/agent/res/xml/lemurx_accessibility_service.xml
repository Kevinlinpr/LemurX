<!--
  LemurX automation service (lemurx.system.*). Off by default; the user turns it
  on in Settings > Accessibility. Grants: read the UI tree of every app, inject
  taps/swipes, global back/home/recents, take screenshots (API 30+).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused|typeViewTextChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/lemurx_accessibility_description"
    android:notificationTimeout="100"
    android:summary="@string/lemurx_accessibility_summary" />
