<?xml version="1.0" encoding="utf-8"?>
<!-- The selected slot: solid #F0F1F2 with 28dp corners (the web bar's
     `backgroundColor: active ? "#F0F1F2" : "transparent"`), plus the same
     ripple on top. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/lemurx_console_cell_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lemurx_console_cell_active" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
