# LemurX default build arguments (arm64 release, local).
# gn gen out/lemurx --args="$(cat ../../tools/args.gn)"   (run from chromium/src)
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_java_debug = false
is_component_build = false
is_official_build = true
treat_warnings_as_errors = false

# Local Siso. Remote execution is opt-in: set use_remoteexec=true and fill
# reapi_* in chromium/.gclient (see README "Distributed build").
use_remoteexec = false
use_siso = true
use_reclient = false

# Extensions on Android are the desktop-Android platform. Leave enable_extensions
# unset so the host toolchain keeps its own default; forcing it off breaks
# chromedriver. is_desktop_android is required because that platform links WebUI
# pieces which refuse a plain phone build.
is_desktop_android = true

# Codec *bundle*, not the app name. "Chromium" is the royalty-free set
# (VP8/VP9/AV1, Opus, Vorbis). "Chrome" also pulls in H.264/AAC, which you
# must not redistribute without patent licenses. App identity is
# branding_path_component below. For a private distribution APK you may add:
#   ffmpeg_branding = "Chrome"
#   proprietary_codecs = true
#   enable_widevine = true
ffmpeg_branding = "Chromium"
proprietary_codecs = false
enable_widevine = false
enable_remoting = false
chrome_pgo_phase = 0
android_channel = "stable"
chrome_public_manifest_package = "com.osmangroupx.aero"
android_override_version_name = "0.2.6"
android_override_version_code = "21"

# LemurX branding: chrome/app/theme/lemurx (BRANDING, product logos),
# components/vector_icons/lemurx. Assets are generated by
# tools/brand/gen_brand_assets.py from the website logo.
branding_path_component = "lemurx"
