# LemurX default build arguments (arm64 release).
# gn gen out/lemurx --args="$(cat ../tools/args.gn)"   (run from chromium/src)
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_java_debug = false
is_component_build = false
is_official_build = true
treat_warnings_as_errors = false

# Distributed build on the self-hosted REAPI cluster (see chromium/.gclient
# custom_vars and tools/rbe/backend.star). Siso talks to the cluster directly;
# reclient is not used. The cluster is plaintext gRPC, so run
# `autoninja -C out/lemurx -reapi_insecure ...` (or export RBE_service_no_security=true).
use_remoteexec = true
use_siso = true
use_reclient = false

# LemurX: no extension system. Lua is the only extension surface.
enable_extensions = false

ffmpeg_branding = "Chrome"
proprietary_codecs = true
enable_widevine = true
enable_remoting = false
chrome_pgo_phase = 0
android_channel = "stable"
chrome_public_manifest_package = "org.lemurx.browser"
android_override_version_name = "0.1.0"
android_override_version_code = "1"

# LemurX branding: chrome/app/theme/lemurx (BRANDING, product logos),
# components/vector_icons/lemurx. Assets are generated by
# tools/brand/gen_brand_assets.py from the website logo.
branding_path_component = "lemurx"
