 '''Handling of the <message> element.'''
 
+import os
 import re
 
 from grit.node import base
@@ -23,6 +24,34 @@ _WHITESPACE = re.compile(
   r'(?P<start>\s*)(?P<body>.+?)(?P<end>\s*)\Z', re.DOTALL | re.MULTILINE
 )
 
+# LemurX: product-name rebranding, applied to every emitted message (source
+# language and all .xtb translations alike) when GRIT runs with
+# -E branding_path_component=lemurx (tools/grit/grit_args.gni forwards the GN
+# arg of the same name; grit.py exports -E pairs into os.environ).
+#
+# It runs on the *output* text in Translate(), never on the parsed message, so
+# message ids (which are hashes of the English source) and therefore the
+# translation lookup stay exactly as upstream. Only the capitalised product
+# names are touched: "Google Chrome", "Chrome" and "Chromium" as whole words.
+# Sibling brands and things that are not this browser are left alone:
+# ChromeOS / Chrome OS, Chromebook, Chromecast, ChromeVox, ChromeDriver,
+# Chrome Web Store, Chrome Remote Desktop, Chrome Enterprise, and anything in
+# lowercase such as chrome:// URLs.
+_LEMURX_BRAND = 'LemurX'
+_LEMURX_BRAND_KEEP = (
+  r'(?!\s+(?:OS|Web\s+Store|Remote\s+Desktop|Enterprise|Browser\s+Cloud'
+  r'|Root\s+Program|Sync\s+Server)(?![A-Za-z]))'
+)
+_LEMURX_BRAND_RE = re.compile(
+  r'(?<![A-Za-z])(?:Google\s+)?Chrom(?:e|ium)(?![A-Za-z])' + _LEMURX_BRAND_KEEP
+)
+
+
+def _LemurXRebrand(text):
+  if 'Chrom' not in text:
+    return text
+  return _LEMURX_BRAND_RE.sub(_LEMURX_BRAND, text)
+
 # <ph> placeholder elements should contain the special character formatters
 # used to format <ph> element content.
 # Android format.
@@ -285,6 +314,10 @@ class MessageNode(base.ContentNode):
