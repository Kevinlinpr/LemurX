+    // LemurX ------------------------------------------------------------------------------
+    private static @Nullable ContextMenuCoordinator sLemurXActive;
+
+    /** LemurX: the context menu on screen, or null. */
+    public static @Nullable ContextMenuCoordinator getActiveForLemurX() {
+        return sLemurXActive;
