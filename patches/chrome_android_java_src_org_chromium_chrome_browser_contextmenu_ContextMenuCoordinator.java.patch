+
+    /** LemurX: {id, title} of every clickable item currently listed. */
+    public List<String[]> describeItemsForLemurX() {
+        List<String[]> out = new ArrayList<>();
+        for (int i = 0; i < mListViews.size(); i++) {
+            for (int j = 0; j < getCount(i); j++) {
+                final ListItem item = getItem(i, j);
+                if (!item.model.getAllSetProperties().contains(MENU_ITEM_ID)) continue;
+                CharSequence title =
+                        item.model.getAllSetProperties().contains(TITLE)
+                                ? item.model.get(TITLE)
+                                : null;
+                out.add(new String[] {
+                        String.valueOf(item.model.get(MENU_ITEM_ID)),
+                        title == null ? "" : title.toString()});
+            }
+        }
+        return out;
+    }
+
+    /** LemurX: activate the item with {@code id}; false when it is not in the menu. */
+    public boolean clickItemForLemurX(int id) {
+        ListItem item = findItem(id);
+        if (item == null) return false;
+        item.model.get(CLICK_LISTENER).onClick(null);
+        return true;
+    }
