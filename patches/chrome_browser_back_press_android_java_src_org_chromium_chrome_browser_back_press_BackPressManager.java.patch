+    // LemurX console shell: the per-tab agent overlay drawn over a live web page. Consulted
+    // before any built-in handler so that a back press closes the overlay instead of
+    // navigating the page underneath. "isActive" is the side-effect free "would the console
+    // consume right now?" check, used when a predictive back gesture *starts* so that no
+    // built-in handler begins a transition (TabOnBackGestureHandler slides the page) for a
+    // gesture the console is going to swallow at commit time; otherwise the page is left
+    // shifted with no cancel/commit and the next gesture fails to navigate.
+    private static java.util.function.@Nullable BooleanSupplier sLemurXConsoleInterceptor;
+    private static java.util.function.@Nullable BooleanSupplier sLemurXConsoleActive;
+
+    public static void setLemurXConsoleInterceptor(
+            java.util.function.@Nullable BooleanSupplier interceptor,
+            java.util.function.@Nullable BooleanSupplier isActive) {
+        sLemurXConsoleInterceptor = interceptor;
+        sLemurXConsoleActive = isActive;
+    }
+
+    // LemurX: live managers, so the console can ask them to re-evaluate whether the
+    // OnBackPressedCallback should be enabled when its overlay appears / disappears
+    // (no built-in handler changes state at that moment, and with system back the callback
+    // is otherwise disabled -> the system would minimize the app).
+    private static final java.util.List<BackPressManager> sLemurXInstances =
+            new java.util.ArrayList<>();
+
+    public static void lemurXConsoleStateChanged() {
+        for (BackPressManager manager : new java.util.ArrayList<>(sLemurXInstances)) {
+            manager.backPressStateChanged();
+        }
+    }
+
+    private static boolean isLemurXConsoleActive() {
+        return sLemurXConsoleInterceptor != null
+                && sLemurXConsoleActive != null
+                && sLemurXConsoleActive.getAsBoolean();
+    }
+
+    private static boolean lemurXConsoleConsumes() {
+        return sLemurXConsoleInterceptor != null && sLemurXConsoleInterceptor.getAsBoolean();
+    }
+
+    private static boolean isLemurXInterceptActive() {
+        return isLemurXConsoleActive();
+    }
